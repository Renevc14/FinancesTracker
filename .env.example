# Database — local SQLite file (dev) or Turso URL (prod)
DATABASE_URL=file:./data/portfolio.db
# DATABASE_AUTH_TOKEN=   # required for Turso remote LibSQL

# Auth.js (single-user credentials)
# Generate: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_USERNAME=rene
AUTH_PASSWORD=change-me-in-production
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000

# Optional: protect /api/cron/daily (Vercel Cron)
# CRON_SECRET=generate-with-openssl-rand-base64-32

# Optional TOTP (base32). If set, login requires a 6-digit code.
# AUTH_TOTP_SECRET=

# App
NEXT_PUBLIC_APP_NAME=Patrimonio
